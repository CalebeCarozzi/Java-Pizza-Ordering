  <diagram name="Page-1" id="UwvuwKY2_oH2xLYWZHWc">
    <mxGraphModel dx="2576" dy="2045" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Java Pizza Ordering - Diagrama de Classes\n\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam linetype ortho\nhide empty members\n\ntop to bottom direction\n\npackage app {\n    class Main {\n        {static} +main(args : String[]) : void\n    }\n}\n\npackage view {\n    class TelaPrincipal\n    class TelaCliente\n    class TelaSabor\n    class TelaPreco\n    class TelaPedido\n    class TelaStatusPedido\n}\n\npackage controller {\n\n    class ClienteController {\n        +cadastrarCliente(nome : String, sobrenome : String, telefone : String) : void\n        +atualizarCliente(id : int, nome : String, sobrenome : String, telefone : String) : void\n        +excluirCliente(id : int) : void\n        +listarClientes() : List&lt;Cliente&gt;\n        +filtrarClientes(sobrenome : String, telefone : String) : List&lt;Cliente&gt;\n        +buscarPorTelefone(telefone : String) : List&lt;Cliente&gt;\n    }\n\n    class SaborController {\n        +cadastrarSabor(nome : String, tipo : TipoPizza) : void\n        +atualizarSabor(id : int, nome : String, tipo : TipoPizza) : void\n        +excluirSabor(id : int) : void\n        +listarSabores() : List&lt;Sabor&gt;\n        +filtrarSabores(nome : String) : List&lt;Sabor&gt;\n    }\n\n    class PrecoController {\n        +consultarPrecos() : TabelaPreco\n        +atualizarPrecos(simples : String, especial : String, premium : String) : void\n    }\n\n    class PedidoController {\n        +mostrarClientes() : List&lt;Cliente&gt;\n        +buscarPorTelefone(telefone : String) : List&lt;Cliente&gt;\n        +listarSabores() : List&lt;Sabor&gt;\n        +buscarOuCriarPedidoAberto(cliente : Cliente) : Pedido\n        +criarNovoPedido(cliente : Cliente) : Pedido\n        +buscaPedidoPorId(id : int) : Pedido\n        +listarPedidosPorCliente(cliente : Cliente) : List&lt;Pedido&gt;\n        +excluirPedido(id : int) : void\n        +finalizarPedido(pedido : Pedido) : void\n        +adicionarPizzaPorDimensao(pedido : Pedido, forma : String, valor : double, sabor1 : Sabor, sabor2 : Sabor, quantidade : int) : void\n        +adicionarPizzaPorArea(pedido : Pedido, forma : String, valor : double, sabor1 : Sabor, sabor2 : Sabor, quantidade : int) : void\n        +atualizarItem(pedido : Pedido, indice : int, forma : String, valor : double, porArea : boolean, sabor1 : Sabor, sabor2 : Sabor, quantidade : int) : void\n        +removerItem(pedido : Pedido, indice : int) : void\n        +calcularResultadoMedida(forma : String, valor : double, porArea : boolean) : String\n        +calcularTotalPedido(pedido : Pedido) : BigDecimal\n    }\n\n    class StatusPedidoController {\n        +listarPedidosPorSobrenomeCliente(sobrenome : String) : List&lt;Pedido&gt;\n        +buscaPedidoPorId(id : int) : Pedido\n        +alterarEstadoPedido(pedido : Pedido, estado : EstadoPedido) : void\n        +excluirPedido(id : int) : void\n        +calcularTotalPedido(pedido : Pedido) : BigDecimal\n    }\n}\n\npackage service {\n\n    class ClienteService {\n        +cadastrarCliente(nome : String, sobrenome : String, telefone : String) : void\n        +editarCliente(id : int, nome : String, sobrenome : String, telefone : String) : void\n        +excluirCliente(id : int) : void\n        +mostrarClientes() : List&lt;Cliente&gt;\n        +filtrarClientes(sobrenome : String, telefone : String) : List&lt;Cliente&gt;\n        +buscarPorTelefone(telefone : String) : List&lt;Cliente&gt;\n    }\n\n    class SaborService {\n        +cadastrarSabor(nome : String, tipo : TipoPizza) : void\n        +editarSabor(id : int, nome : String, tipo : TipoPizza) : void\n        +excluirSabor(id : int) : void\n        +listarSabores() : List&lt;Sabor&gt;\n        +listarPorSabor(nome : String) : List&lt;Sabor&gt;\n    }\n\n    class PrecoService {\n        +getTabelaPreco() : TabelaPreco\n        +atualizarPrecos(simples : String, especial : String, premium : String) : void\n    }\n\n    class PedidoService {\n        +buscarOuCriarPedidoAberto(cliente : Cliente) : Pedido\n        +criarNovoPedido(cliente : Cliente) : Pedido\n        +buscaPedidoPorId(idPedido : int) : Pedido\n        +listarPedidosPorCliente(cliente : Cliente) : List&lt;Pedido&gt;\n        +listarPedidosPorSobrenomeCliente(sobrenome : String) : List&lt;Pedido&gt;\n        +adicionarPizzaPorDimensao(pedido : Pedido, tipoForma : String, dimensao : double, sabor1 : Sabor, sabor2 : Sabor, quantidade : int) : void\n        +adicionarPizzaPorArea(pedido : Pedido, tipoForma : String, area : double, sabor1 : Sabor, sabor2 : Sabor, quantidade : int) : void\n        +atualizarItem(pedido : Pedido, indice : int, tipoForma : String, valor : double, porArea : boolean, sabor1 : Sabor, sabor2 : Sabor, quantidade : int) : void\n        +removerItem(pedido : Pedido, indice : int) : void\n        +calcularTotalPedido(pedido : Pedido) : BigDecimal\n        +finalizarPedido(pedido : Pedido) : void\n        +alterarEstadoPedido(pedido : Pedido, estado : EstadoPedido) : void\n        +excluirPedido(idPedido : int) : void\n        +calcularResultadoMedida(tipoForma : String, valor : double, porArea : boolean) : String\n    }\n\n    class FormaFactory {\n        +criarQuadradoPorLado(lado : double) : Forma\n        +criarCirculoPorRaio(raio : double) : Forma\n        +criarTrianguloPorLado(lado : double) : Forma\n        +criarQuadradoPorArea(area : double) : Forma\n        +criarCirculoPorArea(area : double) : Forma\n        +criarTrianguloPorArea(area : double) : Forma\n    }\n}\n\npackage dao {\n\n    interface ClienteDAO {\n        +salvar(cliente : Cliente) : void\n        +atualizar(cliente : Cliente) : void\n        +excluir(id : int) : void\n        +buscarPorId(id : int) : Cliente\n        +listarTodos() : List&lt;Cliente&gt;\n        +filtrar(sobrenome : String, telefone : String) : List&lt;Cliente&gt;\n    }\n\n    interface SaborDAO {\n        +salvar(sabor : Sabor) : void\n        +atualizar(sabor : Sabor) : void\n        +excluir(id : int) : void\n        +buscarPorId(id : int) : Sabor\n        +listarTodos() : List&lt;Sabor&gt;\n        +filtrarPorNome(nome : String) : List&lt;Sabor&gt;\n    }\n\n    interface PrecoDAO {\n        +consultarPrecos() : TabelaPreco\n        +atualizarPrecos(precos : Map&lt;TipoPizza, BigDecimal&gt;) : void\n    }\n\n    interface PedidoDAO {\n        +salvar(pedido : Pedido) : void\n        +buscarPorId(idPedido : int) : Pedido\n        +buscarAbertoPorCliente(idCliente : int) : Pedido\n        +listarPorCliente(idCliente : int) : List&lt;Pedido&gt;\n        +listarPorSobrenome(sobrenome : String) : List&lt;Pedido&gt;\n        +adicionarItem(idPedido : int, item : ItemPedido) : void\n        +atualizarItem(idPedido : int, idItem : int, item : ItemPedido) : void\n        +removerItem(idPedido : int, idItem : int) : void\n        +alterarEstado(idPedido : int, estado : EstadoPedido) : void\n        +excluir(idPedido : int) : void\n    }\n\n    class DaoFactory {\n        {static} +getClienteDAO() : ClienteDAO\n        {static} +getSaborDAO() : SaborDAO\n        {static} +getPrecoDAO() : PrecoDAO\n        {static} +getPedidoDAO() : PedidoDAO\n    }\n}\n\npackage \&quot;dao.sql\&quot; {\n\n    class ClienteDAOSql\n    class SaborDAOSql\n    class PrecoDAOSql\n\n    class PedidoDAOSql {\n        -consultar(filtro : String, parametro : Object) : List&lt;Pedido&gt;\n        -mapearPedido(rs : ResultSet) : Pedido\n        -mapearItem(rs : ResultSet) : ItemPedido\n        -atualizarTotal(conexao : Connection, idPedido : int) : void\n        -emTransacao(operacao : Operacao&lt;T&gt;) : T\n    }\n\n    interface \&quot;Operacao&lt;T&gt;\&quot; as Operacao &lt;&lt;functional&gt;&gt; {\n        +executar(conexao : Connection) : T\n    }\n}\n\npackage connection {\n\n    class ConnectionFactory {\n        {static} +getConnection() : Connection\n    }\n}\n\npackage model {\n\n    class Cliente {\n        ~id : int\n        ~nome : String\n        ~sobrenome : String\n        ~telefone : String\n    }\n\n    class Pedido {\n        -idPedido : int\n        -cliente : Cliente\n        -itens : List&lt;ItemPedido&gt;\n        -estadoPedido : EstadoPedido\n        -precoTotal : BigDecimal\n        +adicionaItem(item : ItemPedido) : void\n        +removeItem(item : ItemPedido) : void\n        +calculaTotal() : BigDecimal\n        +getPrecoTotal() : BigDecimal\n    }\n\n    class ItemPedido {\n        -idItemPedido : int\n        -pizza : Pizza\n        -quantidade : int\n        -precoUnitario : BigDecimal\n        +calculaSubTotal() : BigDecimal\n    }\n\n    class Pizza {\n        -forma : Forma\n        ~sabor : List&lt;Sabor&gt;\n        +adicionaSabor(sabor : Sabor) : void\n        +calculaArea() : double\n        +calculaPreco(tabelaPreco : TabelaPreco) : double\n    }\n\n    abstract class Forma {\n        {abstract} +calculaArea() : double\n        {abstract} +descricao() : String\n    }\n\n    class Quadrado {\n        -lado : double\n        +calculaArea() : double\n        +descricao() : String\n    }\n\n    class Circulo {\n        -raio : double\n        +calculaArea() : double\n        +descricao() : String\n    }\n\n    class Triangulo {\n        -lado : double\n        +calculaArea() : double\n        +descricao() : String\n    }\n\n    class Sabor {\n        ~idSabor : int\n        ~nome : String\n        ~tipoPizza : TipoPizza\n    }\n\n    class TabelaPreco {\n        -precoSimples : double\n        -precoEspecial : double\n        -precoPremium : double\n        +getPrecoPorTipo(tipo : TipoPizza) : double\n        +alterarPreco(tipo : TipoPizza, valor : double) : void\n    }\n\n    enum TipoPizza {\n        SIMPLES\n        ESPECIAL\n        PREMIUM\n    }\n\n    enum EstadoPedido {\n        ABERTO\n        A_CAMINHO\n        ENTREGUE\n    }\n}\n\n&#39; Inicializacao\n\nMain ..&gt; DaoFactory : cria DAOs\nMain ..&gt; TelaPrincipal : inicializa\nMain ..&gt; PedidoService : instancia\nMain ..&gt; ClienteService : instancia\nMain ..&gt; SaborService : instancia\nMain ..&gt; PrecoService : instancia\nMain ..&gt; FormaFactory : instancia\n\n&#39; Interfaces graficas\n\nTelaPrincipal ..&gt; TelaCliente : abre\nTelaPrincipal ..&gt; TelaSabor : abre\nTelaPrincipal ..&gt; TelaPreco : abre\nTelaPrincipal ..&gt; TelaPedido : abre\nTelaPrincipal ..&gt; TelaStatusPedido : abre\n\nTelaCliente --&gt; ClienteController\nTelaSabor --&gt; SaborController\nTelaPreco --&gt; PrecoController\nTelaPedido --&gt; PedidoController\nTelaStatusPedido --&gt; StatusPedidoController\n\nTelaPrincipal --&gt; ClienteController\nTelaPrincipal --&gt; SaborController\nTelaPrincipal --&gt; PrecoController\nTelaPrincipal --&gt; PedidoController\nTelaPrincipal --&gt; StatusPedidoController\n\n&#39; Controllers e Services\n\nClienteController --&gt; ClienteService\nSaborController --&gt; SaborService\nPrecoController --&gt; PrecoService\n\nPedidoController --&gt; ClienteService\nPedidoController --&gt; SaborService\nPedidoController --&gt; PedidoService\n\nStatusPedidoController --&gt; PedidoService\n\n&#39; Services e DAOs\n\nClienteService --&gt; ClienteDAO\nSaborService --&gt; SaborDAO\nPrecoService --&gt; PrecoDAO\n\nPedidoService --&gt; PedidoDAO\nPedidoService --&gt; SaborDAO\nPedidoService --&gt; PrecoService\nPedidoService --&gt; FormaFactory\n\n&#39; Implementacoes das interfaces DAO\n\nClienteDAOSql ..|&gt; ClienteDAO\nSaborDAOSql ..|&gt; SaborDAO\nPrecoDAOSql ..|&gt; PrecoDAO\nPedidoDAOSql ..|&gt; PedidoDAO\n\n&#39; DaoFactory\n\nDaoFactory ..&gt; ClienteDAOSql : cria\nDaoFactory ..&gt; SaborDAOSql : cria\nDaoFactory ..&gt; PrecoDAOSql : cria\nDaoFactory ..&gt; PedidoDAOSql : cria\n\n&#39; Conexao e transacoes\n\nClienteDAOSql ..&gt; ConnectionFactory\nSaborDAOSql ..&gt; ConnectionFactory\nPrecoDAOSql ..&gt; ConnectionFactory\nPedidoDAOSql ..&gt; ConnectionFactory\n\nPedidoDAOSql ..&gt; Operacao : transacao\n\n&#39; DAOs e Models\n\nClienteDAO ..&gt; Cliente\nSaborDAO ..&gt; Sabor\nPrecoDAO ..&gt; TabelaPreco\nPedidoDAO ..&gt; Pedido\nPedidoDAO ..&gt; ItemPedido\n\n&#39; Relacionamentos do dominio\n\nPedido \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Cliente : cliente\nPedido \&quot;1\&quot; *-- \&quot;0..*\&quot; ItemPedido : itens\n\nItemPedido \&quot;1\&quot; *-- \&quot;1\&quot; Pizza\n\nPizza \&quot;1\&quot; *-- \&quot;1\&quot; Forma\nPizza \&quot;0..*\&quot; --&gt; \&quot;1..2\&quot; Sabor : sabores\n\nSabor --&gt; TipoPizza\nPedido --&gt; EstadoPedido\n\nPizza ..&gt; TabelaPreco : calcula preco\nTabelaPreco ..&gt; TipoPizza\n\n&#39; Heranca e polimorfismo\n\nQuadrado --|&gt; Forma\nCirculo --|&gt; Forma\nTriangulo --|&gt; Forma\n\n&#39; FormaFactory\n\nFormaFactory ..&gt; Quadrado : cria\nFormaFactory ..&gt; Circulo : cria\nFormaFactory ..&gt; Triangulo : cria\n\n&#39; Objetos utilizados pelas telas\n\nTelaPedido --&gt; Pedido : selecionado\nTelaPedido --&gt; Cliente : selecionado\nTelaStatusPedido --&gt; Pedido : selecionado\n\nlegend bottom\n    Diagrama das classes de producao e dependencias principais.\n    Getters, setters, detalhes de Swing, excecoes e testes omitidos.\n    Multiplicidade de sabores considera uma pizza valida para venda.\nendlegend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ypUPq6UHHaIJQVi8US1u-27">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
